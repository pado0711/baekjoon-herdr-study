#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import time
from pathlib import Path


PROJECT = Path(__file__).resolve().parent
MOD_NAME = "baekjoon-roadmap"
TAB_NAME = "백준 학습 로드맵"


def herdr_json(*args):
    result = subprocess.run(["herdr-app", *args], capture_output=True, text=True, check=True)
    return json.loads(result.stdout)


def herdr_action(command, **args):
    return herdr_json("do", command, json.dumps(args, ensure_ascii=False))


def get_spaces():
    try:
        return herdr_json("ls")["spaces"]
    except subprocess.CalledProcessError:
        subprocess.Popen(
            ["herdr-app"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    for _ in range(40):
        time.sleep(0.25)
        try:
            return herdr_json("ls")["spaces"]
        except subprocess.CalledProcessError:
            continue
    raise RuntimeError("Herdr Desktop 창이 열리면 ./setup을 다시 실행하세요.")


def open_roadmap_tab(space_id):
    for _ in range(20):
        try:
            return herdr_action("tab.new", name=TAB_NAME, space=space_id, mod=MOD_NAME, props={"project": str(PROJECT)})
        except subprocess.CalledProcessError as error:
            if f'no mod "{MOD_NAME}"' not in (error.stdout + error.stderr):
                raise
            time.sleep(0.15)
    raise RuntimeError("Herdr가 로드맵 모드를 읽지 못했습니다. Herdr Desktop을 다시 연 뒤 ./setup을 실행하세요.")


def install_mod(app_home, name):
    source = PROJECT / "mods" / name
    destination = app_home / "mods" / name
    if destination.exists():
        for entry in destination.iterdir():
            if entry.name not in {"mod.json", "main.js", "jsconfig.json"} and entry.suffix != ".ts":
                raise RuntimeError(f"이미 사용 중인 Herdr 모드 폴더입니다: {destination}")
    subprocess.run(["herdr-app", "check", str(source)], check=True)
    destination.mkdir(parents=True, exist_ok=True)
    for filename in ("mod.json", "main.js"):
        file = source / filename
        target = destination / filename
        if not target.exists() or target.read_bytes() != file.read_bytes():
            shutil.copy2(file, target)


def main():
    if not shutil.which("herdr-app"):
        raise RuntimeError("Herdr Desktop을 설치한 뒤 ./setup을 다시 실행하세요.")

    app_home = Path(os.environ.get("HERDR_APP_HOME") or Path.home() / ".config" / "herdr-app").expanduser()
    for name in ("baekjoon-problem", MOD_NAME):
        install_mod(app_home, name)

    space = next(
        (
            space for space in get_spaces()
            if not space.get("machine") and space.get("folder") and Path(space["folder"]).resolve() == PROJECT
        ),
        None,
    )
    if space is None:
        space_id = herdr_action("space.new", name="백준 Python", folder=str(PROJECT), focus=False)["space"]
    else:
        space_id = space["id"]
        tab = next((tab for tab in space["tabs"] if tab["name"] == TAB_NAME), None)
        if tab is not None:
            herdr_action("space.select", id=space_id)
            herdr_action("tab.select", id=tab["id"])
            print(f"Herdr에서 '{TAB_NAME}' 탭을 열었습니다.")
            return

    herdr_action("space.select", id=space_id)
    open_roadmap_tab(space_id)
    print(f"Herdr에서 '{TAB_NAME}' 탭을 만들었습니다.")


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.stderr or error.stdout or f"Herdr 명령이 실패했습니다: {error.cmd}") from None
    except (OSError, RuntimeError) as error:
        raise SystemExit(str(error)) from None
